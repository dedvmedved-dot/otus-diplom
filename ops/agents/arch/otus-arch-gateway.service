[Unit]
Description=hermes-5.187.1.37-a-arch Gateway (otus-diplom architect)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/hermes-5.187.1.37-a-arch/.hermes/hermes-agent/.hermes/bin/hermes gateway run
WorkingDirectory=/home/hermes-5.187.1.37-a-arch/.hermes
Environment=PATH=/home/hermes-5.187.1.37-a-arch/.hermes/hermes-agent/node_modules/.bin:/home/hermes-5.187.1.37-a-arch/.hermes/tools/node-26.12.1-linux-x64/bin:/home/hermes-5.187.1.37-a-arch/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=HERMES_HOME=/home/hermes-5.187.1.37-a-arch/.hermes
Environment=HERMES_SUPERVISED_CHILD=1
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=/home/hermes-5.187.1.37-a-arch/.hermes/hermes-agent/.hermes/bin/hermes --run-module gateway.systemd_stop_mark
ExecStopPost=/home/hermes-5.187.1.37-a-arch/.hermes/hermes-agent/.hermes/bin/hermes --run-module gateway.cgroup_cleanup
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
