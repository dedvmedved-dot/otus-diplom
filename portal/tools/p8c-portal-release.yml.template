# P8C Portal release workflow (CI build/sign/push to private GHCR).
# NOT a PAK deployment: no kubeconfig/DB/S3/UI credentials in CI.
# Manual workflow_dispatch only; main ref; exact source SHA checkout.
#
# NOTE: action refs below use immutable upstream commit SHAs (the tag is shown
# only as a comment). Verify each SHA against upstream before first run.
name: p8c-portal-release

on:
  workflow_dispatch: {}

permissions:
  contents: read
  packages: write
  id-token: write

env:
  GO_VERSION: "1.27.3"
  GO_SHA256: "65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40"
  REGISTRY: ghcr.io
  IMAGE_NAME: ${{ github.repository }}-portal

jobs:
  release:
    if: github.repository == 'dedvmedved-dot/otus-diplom' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-latest
    steps:
      - name: Checkout exact source
        uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.sha }}

      - name: Verify clean tree and expected source SHA
        run: |
          git diff --exit-code
          echo "building source commit: ${{ github.sha }}"

      - name: Set up Go
        uses: actions/setup-go@0aaccfd150d50ccaeb58ebd88d36e91967a5f35b # v5.4.0
        with:
          go-version: "1.27.3"

      - name: Build + test + vet
        working-directory: portal
        run: |
          go mod download
          go mod verify
          go vet ./...
          go test ./...
          CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
            -ldflags "-s -w -X main.sourceRevision=${{ github.sha }} -X main.buildTime=1970-01-01T00:00:00Z" \
            -o portal ./cmd/portal

      - name: Install Syft
        run: |
          curl -sSfL https://github.com/anchore/syft/releases/download/v1.55.0/syft_1.55.0_linux_amd64.tar.gz -o syft.tar.gz
          echo "bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d  syft.tar.gz" | sha256sum -c
          tar -xzf syft.tar.gz && sudo mv syft /usr/local/bin/

      - name: Install Trivy
        run: |
          curl -sSfL https://github.com/aquasecurity/trivy/releases/download/v0.76.0/trivy_0.76.0_Linux-64bit.tar.gz -o trivy.tar.gz
          echo "e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7  trivy.tar.gz" | sha256sum -c
          tar -xzf trivy.tar.gz && sudo mv trivy /usr/local/bin/

      - name: Generate SBOM
        working-directory: portal
        run: syft dir:. -o spdx-json=sbom.spdx.json

      - name: Scan (code + binary + OCI)
        working-directory: portal
        run: |
          trivy fs --exit-code 1 --severity HIGH,CRITICAL --no-progress .
          trivy rootfs --exit-code 1 --severity HIGH,CRITICAL --no-progress ./portal

      - name: Login to GHCR
        uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and push image (private)
        working-directory: portal
        run: |
          docker build -f Containerfile -t ghcr.io/${{ github.repository }}-portal:latest .
          docker push ghcr.io/${{ github.repository }}-portal:latest

      - name: Install Cosign
        uses: sigstore/cosign-installer@59acb6260d86c0f8c4bf0748f02916c9f753c7cd # v3.5.0

      - name: Sign image (keyless, exact identity)
        run: |
          cosign sign --yes \
            -a repo=${{ github.repository }} \
            -a workflow=${{ github.workflow }} \
            -a ref=${{ github.sha }} \
            ghcr.io/${{ github.repository }}-portal@$(docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/${{ github.repository }}-portal:latest | cut -d@ -f2)
