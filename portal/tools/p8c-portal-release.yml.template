# P8C Portal release workflow — TEMPLATE (NOT published to .github/workflows).
# To be published by Owner via GitHub web UI after Architect review, then
# dispatched manually. CI build/sign/push to PRIVATE GHCR only; NO PAK access.
# Action refs are immutable commit SHAs (verify against upstream before run).
name: p8c-portal-release

on:
  workflow_dispatch: {}

permissions:
  contents: read

env:
  GO_VERSION: "1.27.3"
  GO_SHA256: "65efbc80fdc1fa2cd2631cad5b481777a68e8725f34e89f50fc6ac714e379b40"
  BUILDKIT_VERSION: "v0.34.0"
  ROOTLESSKIT_VERSION: "2.3.1"
  SYFT_VERSION: "1.55.0"
  TRIVY_VERSION: "0.76.0"
  COSIGN_VERSION: "3.1.3"
  REGISTRY: ghcr.io
  IMAGE: ghcr.io/${{ github.repository }}-portal

jobs:
  test:
    if: github.repository == 'dedvmedved-dot/otus-diplom' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    services:
      postgres:
        image: postgres:17.10-bookworm@sha256:9b18b78397054fce88a9552e9d5a3ad5bb7fd258c5b3cc1c5028e46373d6ea8f
        env:
          POSTGRES_PASSWORD: postgres
          POSTGRES_DB: portal_test
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres" --health-interval 10s
          --health-timeout 5s --health-retries 5
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.sha }}

      - name: Install verified Go archive
        run: bash portal/tools/install-verified-go.sh

      - name: Go vet + test + race
        working-directory: portal
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/test-evidence"
          go version | tee "$RUNNER_TEMP/test-evidence/go-version.txt"
          go mod download && go mod verify
          go vet ./... 2>&1 | tee "$RUNNER_TEMP/test-evidence/vet.txt"
          go test -count=1 -v ./... 2>&1 | tee "$RUNNER_TEMP/test-evidence/unit.txt"
          go test -race -count=1 ./... 2>&1 | tee "$RUNNER_TEMP/test-evidence/race.txt"

      - name: DB integration tests (isolated postgres:17, FAIL if unset)
        working-directory: portal
        env:
          TEST_DATABASE_URL: postgres://postgres:postgres@localhost:5432/portal_test
        run: |
          set -euo pipefail
          test -n "$TEST_DATABASE_URL" || { echo "TEST_DATABASE_URL unset"; exit 1; }
          go test -tags integration -count=1 ./internal/store/ -v 2>&1 | tee "$RUNNER_TEMP/test-evidence/integration.txt"

      - name: Helper mock tests (both helpers)
        working-directory: portal
        run: |
          set -euo pipefail
          python3 tools/test_helpers.py -v 2>&1 | tee "$RUNNER_TEMP/test-evidence/helpers.txt"
          python3 tools/test_release.py -v 2>&1 | tee "$RUNNER_TEMP/test-evidence/release-checks.txt"

      - name: JS/browser fixture smoke (jsdom renderer + fixture shape)
        working-directory: portal
        run: |
          set -euo pipefail
          npm ci --ignore-scripts
          node --version | tee "$RUNNER_TEMP/test-evidence/node-version.txt"
          node web/renderer-smoke.test.mjs 2>&1 | tee "$RUNNER_TEMP/test-evidence/renderer.txt"
          node web/fixture-smoke.test.mjs 2>&1 | tee "$RUNNER_TEMP/test-evidence/fixtures.txt"
          bash tools/test-dataflow.sh 2>&1 | tee "$RUNNER_TEMP/test-evidence/dataflow.txt"

      - name: Retain test evidence
        if: always()
        uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808 # v4.3.3
        with:
          name: portal-source-tests
          if-no-files-found: error
          path: ${{ runner.temp }}/test-evidence/

  release:
    if: github.repository == 'dedvmedved-dot/otus-diplom' && github.ref == 'refs/heads/main'
    needs: test
    runs-on: ubuntu-24.04
    # Minimal, job-scoped elevation: only the release job may push packages and
    # request OIDC for keyless signing. The test job keeps the repo-wide
    # contents:read and nothing else.
    permissions:
      contents: read
      packages: write
      id-token: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.sha }}

      - name: Verify clean tree and source provenance
        run: |
          set -euo pipefail
          git diff --exit-code
          echo "SOURCE_SHA=${{ github.sha }}"
          echo "BUILD_TIME=$(git log -1 --format=%cI --date=iso-strict)"

      - name: Install verified Go archive
        run: bash portal/tools/install-verified-go.sh

      - name: Private package prerequisite (before any push)
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          mkdir -p "$RUNNER_TEMP/release"
          python3 portal/tools/release-check.py private > "$RUNNER_TEMP/release/private-before.json"
          cp "$RUNNER_TEMP/go-version.txt" "$RUNNER_TEMP/go-binary.sha256" "$RUNNER_TEMP/release/"

      - name: Build binary (reproducible)
        working-directory: portal
        run: |
          set -euo pipefail
          CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath \
            -ldflags "-s -w -X main.sourceRevision=${{ github.sha }} -X main.buildTime=1970-01-01T00:00:00Z" \
            -o portal ./cmd/portal

      - name: Install rootlesskit + BuildKit (pinned, verified)
        run: |
          set -euo pipefail
          sudo apt-get update && sudo apt-get install -y uidmap slirp4netns
          curl -sSfL "https://github.com/rootless-containers/rootlesskit/releases/download/v${ROOTLESSKIT_VERSION}/rootlesskit-x86_64.tar.gz" -o rootlesskit.tar.gz
          echo "caafdce18e0959f078b4b478d4f352ebf3d556e373265fc7831f1a6d70219ee0  rootlesskit.tar.gz" | sha256sum -c
          tar -xzf rootlesskit.tar.gz && sudo mv rootlesskit rootlessctl rootlesskit-docker-proxy /usr/local/bin/
          curl -sSfL "https://github.com/moby/buildkit/releases/download/${BUILDKIT_VERSION}/buildkit-${BUILDKIT_VERSION}.linux-amd64.tar.gz" -o buildkit.tar.gz
          echo "14813b1fb2a40082114e6d386c6fc5e7dd5298176ce7ee1a18bc33e73e109ac3  buildkit.tar.gz" | sha256sum -c
          tar -xzf buildkit.tar.gz && sudo install -m 0755 bin/buildctl bin/buildkitd /usr/local/bin/

      - name: Login to GHCR (BEFORE build/push)
        uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build OCI image (rootless buildctl) + immutable digest from metadata
        working-directory: portal
        env:
          BUILDKIT_HOST: unix:///tmp/buildkit.sock
        run: |
          set -euo pipefail
          unshare -Ur true || { echo "STOP: runner user namespaces unavailable"; exit 1; }
          rootlesskit --net=slirp4netns --copy-up=/etc --copy-up=/run \
            buildkitd --oci-worker-no-process-sandbox --addr unix:///tmp/buildkit.sock > /tmp/buildkitd.log 2>&1 &
          READY=0
          for i in $(seq 1 30); do
            if buildctl debug workers >/dev/null 2>&1; then READY=1; break; fi
            sleep 1
          done
          if [ "$READY" != "1" ]; then
            echo "buildkitd worker not ready after 30s; last log lines:"
            tail -n 20 /tmp/buildkitd.log
            exit 1
          fi
          buildctl build \
            --frontend=dockerfile.v0 \
            --opt filename=Containerfile \
            --local context=. \
            --local dockerfile=. \
            --output type=image,name=${IMAGE}:candidate,push=true \
            --metadata-file "$RUNNER_TEMP/release/build-metadata.json"
          DIGEST=$(python3 tools/release-check.py digest "$RUNNER_TEMP/release/build-metadata.json")
          echo "IMAGE_DIGEST=${DIGEST}" >> "$GITHUB_ENV"

      - name: Verify registry bytes and private visibility after push
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          python3 portal/tools/release-check.py registry "$IMAGE_DIGEST" > "$RUNNER_TEMP/release/registry.json"
          python3 portal/tools/release-check.py private > "$RUNNER_TEMP/release/private-after.json"

      - name: Install Syft + generate final-image SBOM
        run: |
          set -euo pipefail
          curl -sSfL "https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz" -o syft.tar.gz
          echo "bb65249542db5fedeeb4d3f9b018b75e7264dbfbbb10486f044581a92f90490d  syft.tar.gz" | sha256sum -c
          tar -xzf syft.tar.gz && sudo mv syft /usr/local/bin/
          syft "${IMAGE}@${IMAGE_DIGEST}" -o spdx-json="$RUNNER_TEMP/release/sbom.spdx.json"

      - name: Install Trivy + scan final image (binary + OCI)
        run: |
          set -euo pipefail
          curl -sSfL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" -o trivy.tar.gz
          echo "e24b1c51293c1b15e4ba8d45bbc7891ba053f90278ec2698f3562c993e145fe7  trivy.tar.gz" | sha256sum -c
          tar -xzf trivy.tar.gz && sudo mv trivy /usr/local/bin/
          trivy fs --exit-code 1 --severity HIGH,CRITICAL --format json --output "$RUNNER_TEMP/release/scan-binary.json" --no-progress portal/portal
          trivy image --exit-code 1 --severity HIGH,CRITICAL --format json --output "$RUNNER_TEMP/release/scan-image.json" --no-progress "${IMAGE}@${IMAGE_DIGEST}"

      - name: Install Cosign (exact pinned version)
        run: |
          set -euo pipefail
          curl -sSfL "https://github.com/sigstore/cosign/releases/download/v${COSIGN_VERSION}/cosign-linux-amd64" -o cosign
          echo "4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71  cosign" | sha256sum -c
          chmod +x cosign && sudo mv cosign /usr/local/bin/

      - name: Sign keyless + verify exact identity/issuer/source
        run: |
          set -euo pipefail
          cosign sign --yes \
            -a repo=${{ github.repository }} \
            -a workflow=${{ github.workflow }} \
            -a ref=${{ github.sha }} \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/sign.txt" 2>&1
          cosign verify \
            --certificate-identity "https://github.com/${{ github.repository }}/.github/workflows/p8c-portal-release.yml@refs/heads/main" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            -a ref=${{ github.sha }} \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/signature.json"

      - name: SBOM + provenance attestation (generate + verify both)
        run: |
          set -euo pipefail
          python3 portal/tools/release-check.py predicate "${{ github.sha }}" > "$RUNNER_TEMP/release/provenance.json"
          cosign attest --yes --type spdxjson --predicate "$RUNNER_TEMP/release/sbom.spdx.json" \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/attest-sbom.txt" 2>&1
          cosign attest --yes --type slsaprovenance --predicate "$RUNNER_TEMP/release/provenance.json" \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/attest-provenance.txt" 2>&1
          cosign verify-attestation --type spdxjson \
            --certificate-identity "https://github.com/${{ github.repository }}/.github/workflows/p8c-portal-release.yml@refs/heads/main" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/attestation-sbom.jsonl"
          cosign verify-attestation --type slsaprovenance \
            --certificate-identity "https://github.com/${{ github.repository }}/.github/workflows/p8c-portal-release.yml@refs/heads/main" \
            --certificate-oidc-issuer "https://token.actions.githubusercontent.com" \
            "${IMAGE}@${IMAGE_DIGEST}" > "$RUNNER_TEMP/release/attestation-provenance.jsonl"
          python3 portal/tools/release-check.py verified "$RUNNER_TEMP/release" "$IMAGE_DIGEST" "${{ github.sha }}" > "$RUNNER_TEMP/release/verification.json"

      - name: Upload SBOM + signature + provenance artifacts
        if: always()
        uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808 # v4.3.3
        with:
          name: portal-sbom-signature-provenance
          if-no-files-found: error
          path: ${{ runner.temp }}/release/
