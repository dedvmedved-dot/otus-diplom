# P8C Portal private-seed bootstrap workflow — TEMPLATE (NOT published to .github/workflows).
# Separate one-shot Owner-authorized bootstrap. Seed is NOT the Portal release, NOT deployable.
# Exact target: ghcr.io/dedvmedved-dot/otus-diplom-portal (private container package).
# Typed precheck decides REUSE | CREATE_ALLOWED | STOP; REUSE/STOP perform ZERO build/push.
name: p8c-portal-seed

on:
  workflow_dispatch:
    inputs:
      first_creation_gate:
        description: 'Typed first-creation gate JSON {source_sha, issued_at_utc, expiry_hours, mode=LIVE}; Owner supplies it explicitly. Absent => REUSE/STOP only.'
        required: false
        type: string

permissions:
  contents: read
  packages: write

env:
  REGISTRY: ghcr.io
  IMAGE: ghcr.io/dedvmedved-dot/otus-diplom-portal
  SEED_TAG: bootstrap-seed

jobs:
  precheck:
    if: github.repository == 'dedvmedved-dot/otus-diplom' && github.ref == 'refs/heads/main'
    runs-on: ubuntu-24.04
    timeout-minutes: 5
    outputs:
      result: ${{ steps.pre.outputs.result }}
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.sha }}

      - name: Deliver typed first-creation gate (explicit Owner input; never materialized from nowhere)
        if: github.event.inputs.first_creation_gate != ''
        run: |
          printf '%s' '${{ github.event.inputs.first_creation_gate }}' > "$RUNNER_TEMP/first-creation-gate.json"

      - name: Typed private-package precheck
        id: pre
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          if python3 portal/tools/release-check.py private > "$RUNNER_TEMP/private.json" 2>/dev/null; then
            echo "result=REUSE" >> "$GITHUB_OUTPUT"
            echo "REUSE: existing private associated package"
          elif [ -f "$RUNNER_TEMP/first-creation-gate.json" ] && \
               python3 portal/tools/release-check.py first-creation "$RUNNER_TEMP/first-creation-gate.json" >/dev/null 2>&1; then
            echo "result=CREATE_ALLOWED" >> "$GITHUB_OUTPUT"
            echo "CREATE_ALLOWED: typed first-creation gate verified"
          else
            echo "result=STOP" >> "$GITHUB_OUTPUT"
            echo "STOP: no private package and no typed first-creation gate" >&2
            exit 1
          fi

  seed:
    if: github.repository == 'dedvmedved-dot/otus-diplom' && github.ref == 'refs/heads/main'
    needs: precheck
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    permissions:
      contents: read
      packages: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2
        with:
          persist-credentials: false
          ref: ${{ github.sha }}

      # REUSE / STOP => zero build/push. Only CREATE_ALLOWED proceeds.
      - name: Record REUSE/STOP (no build, no push)
        if: needs.precheck.outputs.result != 'CREATE_ALLOWED'
        run: |
          python3 -c "import json,os; json.dump({'seed': '${{ needs.precheck.outputs.result }}', 'build_push_count': 0, 'not_deployable': True}, open(os.environ['RUNNER_TEMP']+'/seed-evidence.json','w'))"

      - name: Login to GHCR
        if: needs.precheck.outputs.result == 'CREATE_ALLOWED'
        uses: docker/login-action@9780b0c442fbb1117ed29e0efdff1e18412f7567 # v3.3.0
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Install rootlesskit + BuildKit (pinned, verified)
        if: needs.precheck.outputs.result == 'CREATE_ALLOWED'
        run: |
          set -euo pipefail
          sudo apt-get update && sudo apt-get install -y uidmap slirp4netns
          curl -sSfL "https://github.com/rootless-containers/rootlesskit/releases/download/v2.3.1/rootlesskit-x86_64.tar.gz" -o rootlesskit.tar.gz
          echo "caafdce18e0959f078b4b478d4f352ebf3d556e373265fc7831f1a6d70219ee0  rootlesskit.tar.gz" | sha256sum -c
          tar -xzf rootlesskit.tar.gz && sudo mv rootlesskit rootlessctl rootlesskit-docker-proxy /usr/local/bin/
          curl -sSfL "https://github.com/moby/buildkit/releases/download/v0.34.0/buildkit-v0.34.0.linux-amd64.tar.gz" -o buildkit.tar.gz
          echo "14813b1fb2a40082114e6d386c6fc5e7dd5298176ce7ee1a18bc33e73e109ac3  buildkit.tar.gz" | sha256sum -c
          tar -xzf buildkit.tar.gz && sudo install -m 0755 bin/buildctl bin/buildkitd /usr/local/bin/

      - name: Start rootless BuildKit (bounded readiness + cleanup)
        if: needs.precheck.outputs.result == 'CREATE_ALLOWED'
        env:
          BUILDKIT_HOST: unix:///tmp/seed-buildkit.sock
        run: |
          set -euo pipefail
          unshare -Ur true || { echo "STOP: user namespaces unavailable"; exit 1; }
          rootlesskit --net=slirp4netns --copy-up=/etc --copy-up=/run \
            buildkitd --oci-worker-no-process-sandbox --addr unix:///tmp/seed-buildkit.sock > /tmp/seed-buildkitd.log 2>&1 &
          BK_PID=$!
          echo "$BK_PID" > /tmp/seed-buildkitd.pid
          # NOTE: no EXIT trap here — the daemon must survive into the Build step.
          READY=0
          for i in $(seq 1 30); do
            if buildctl --addr unix:///tmp/seed-buildkit.sock debug workers >/dev/null 2>&1; then READY=1; break; fi
            sleep 1
          done
          if [ "$READY" != "1" ]; then echo "buildkitd not ready after 30s"; tail -20 /tmp/seed-buildkitd.log; exit 1; fi
          echo "BUILDKIT_READY=1" >> "$GITHUB_ENV"

      - name: Build + push minimal seed (bootstrap-only, not deployable)
        if: needs.precheck.outputs.result == 'CREATE_ALLOWED'
        working-directory: portal/tools
        env:
          BUILDKIT_HOST: unix:///tmp/seed-buildkit.sock
        run: |
          set -euo pipefail
          printf 'bootstrap-only seed, not deployable\n' > seed.txt
          buildctl build --frontend=dockerfile.v0 --opt filename=Seed.Containerfile \
            --local context=. --local dockerfile=. \
            --output type=image,name=${IMAGE}:${SEED_TAG},push=true \
            --metadata-file "$RUNNER_TEMP/seed-metadata.json"
          python3 release-check.py digest "$RUNNER_TEMP/seed-metadata.json" > "$RUNNER_TEMP/seed-digest.txt"
          echo "SEED_DIGEST=$(cat "$RUNNER_TEMP/seed-digest.txt")" >> "$GITHUB_ENV"
          # cleanup: stop the daemon only after the build
          kill "$(cat /tmp/seed-buildkitd.pid)" 2>/dev/null || true

      - name: Record seed digest + visibility + association (typed evidence)
        if: needs.precheck.outputs.result == 'CREATE_ALLOWED'
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          set -euo pipefail
          python3 portal/tools/release-check.py private > "$RUNNER_TEMP/private-after.json"
          python3 -c "import json,os; json.dump({'seed_digest': os.environ.get('SEED_DIGEST',''), 'not_deployable': True, 'seed_not_application_digest': os.environ.get('SEED_DIGEST','') != os.environ.get('APP_IMAGE_DIGEST','')}, open(os.environ['RUNNER_TEMP']+'/seed-evidence.json','w'))"

      - name: Upload seed evidence
        if: always()
        uses: actions/upload-artifact@65462800fd760344b1a7b4382951275a0abb4808 # v4.3.3
        with:
          name: portal-seed-evidence
          if-no-files-found: error
          path: ${{ runner.temp }}/seed-evidence.json
