# .gitignore
#
# PRINCIPLE (TASK-003): .gitignore is NOT a secret-protection system.
# Real protection = secret scan + code review + prohibition of plaintext
# credentials in Git. This file therefore blocks files that CONTAIN secret
# values by their concrete type/name — NOT every filename that merely contains
# the word "secret"/"token"/"password"/"credentials". Legitimate
# Secret-*reference* manifests (which hold only pointers to a Secret Manager)
# must remain under version control.

# === Environment files with real values ===
.env
.env.local
.env.development
.env.production
.env.*.local

# === Private keys / certificates / key material ===
*.key
*.pem
*.p12
*.pfx
id_rsa
id_ed25519
id_ecdsa
*.ppk

# === Kubeconfig / cluster admin credentials ===
*.kubeconfig
kubeconfig
admin.conf

# === Vault / ansible-vault ===
vault-password*
.vault-token
vault-token
*.vault

# === Terraform state (may embed secrets) ===
*.tfstate
*.tfstate.*
*.tfvars

# === Ansible ===
*.retry
ansible/**/host_vars/**/vault.yml
ansible/**/group_vars/**/vault.yml

# === OS / editor cruft ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# === Python / tooling ===
__pycache__/
*.pyc
.venv/
venv/

# === Logs / tmp ===
*.log
tmp/
.tmp/

# === Explicit allow-list (secret-free by construction) ===
# Templates / examples never carry real secrets:
!*.example
!*.sample
!.env.example
!*.example.*
# Secret-REFERENCE manifests carry only pointers to a Secret Manager, not
# secret values, and MUST stay tracked:
!external-secret*.yaml
!secret-store*.yaml
!cluster-secret-store*.yaml
!*-secret-reference*.yaml
# Evidence secret-scan REPORTS record a scan verdict, never secret values:
!evidence/**/secret-check.txt
